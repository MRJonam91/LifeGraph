{
  "name": "lifegraph",
  "version": "1.2.0-beta.1",
  "description": "Portable personal knowledge & entity graph: connect persons, documents, contracts, and deadlines with cryptographic provenance, fine-grained consent tags, and lossless export.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Manoj Rollo <fbxmano@gmail.com> (https://github.com/MRJonam91)",
  "homepage": "https://github.com/MRJonam91/LifeGraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MRJonam91/LifeGraph.git"
  },
  "bugs": {
    "url": "https://github.com/MRJonam91/LifeGraph/issues"
  },
  "keywords": [
    "lifegraph",
    "personal-data",
    "knowledge-graph",
    "graph-database",
    "data-portability",
    "privacy",
    "provenance",
    "gdpr",
    "consent-management",
    "deadlines",
    "contract-management",
    "local-first",
    "cli",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "lifegraph": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema.json",
    "README.md",
    "README.it.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/MRJonam91"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/mrjonam"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/mrjonam"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/manorollo"
    }
  ],
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.7.3"
  }
}
